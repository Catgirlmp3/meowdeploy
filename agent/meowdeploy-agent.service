[Unit]
Description=MeowDeploy Fleet Agent
After=network-online.target tor.service
Wants=network-online.target tor.service
# The installer writes this file with mode 0600. Keep tokens out of unit files
# and out of the process command line.
ConditionPathExists=/etc/meowdeploy/agent.json

[Service]
Type=simple
ExecStart=/opt/meowdeploy/venv/bin/python3 /opt/meowdeploy/meowdeploy_agent.py --config /etc/meowdeploy/agent.json
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=78
User=root
UMask=0077
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=-/var/lib/meowdeploy -/etc/systemd/system/meowdeploy-miner.service.d -/etc/systemd/system/meowdeploy-agent.service.d
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meowdeploy-agent

[Install]
WantedBy=multi-user.target
